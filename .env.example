# Umanah AI Lab example configuration
# Copy to .env locally and populate secrets there. Never commit .env.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
API_PORT=8000

# Set this after the stable HUNGREE Goat USB mount is identified on ai-node-01.
UMANAH_RUNTIME_ROOT=/path/to/hungree-goat-drive/umanah-ai-lab

POSTGRES_DB=umanah_ai_lab
POSTGRES_USER=umanah
POSTGRES_PASSWORD=change-me-locally
