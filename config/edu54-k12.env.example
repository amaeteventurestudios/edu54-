# Copy to <EDU54_ROOT>/config/edu54-k12.env and fill paths. Never commit the real file.
LABOS_BRAND=edu54
LABOS_EDITION=k12
LABOS_INSTANCE=edu54-k12
COMPOSE_PROJECT_NAME=edu54-k12
DOCKER_CONTEXT=ai-data
EDU54_ROOT=/srv/ai-node/storage/ssd/edu54   # verify <SSD> first
WEB_PORT=8300
API_PORT=8301
DATABASE_URL=sqlite:///${EDU54_ROOT}/database/k12.db
KNOWLEDGE_DIR=${EDU54_ROOT}/knowledge
LOG_DIR=${EDU54_ROOT}/logs/k12
INFERENCE_URL=http://127.0.0.1:8320     # fallback: http://127.0.0.1:8120 (AI Lab Ollama, read-only client) per RAM guard
KIWIX_URL=http://127.0.0.1:8312
KOLIBRI_URL=http://127.0.0.1:8311
TUTOR_MODEL=qwen3:4b                     # Mac mini: qwen3:14b
SAFETY_MODEL=qwen3guard-small            # else llama-guard3:1b
EMBED_MODEL=nomic-embed-text
SESSION_SECRET=                          # generate: openssl rand -hex 32
